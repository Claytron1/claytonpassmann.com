---
import { SITE_TITLE, LINKS } from '../consts';

const links = [
	LINKS.email && { href: `mailto:${LINKS.email}`, label: 'Email' },
	LINKS.github && { href: LINKS.github, label: 'GitHub' },
	LINKS.linkedin && { href: LINKS.linkedin, label: 'LinkedIn' },
	{ href: '/rss.xml', label: 'RSS' },
].filter(Boolean) as { href: string; label: string }[];
---

<footer>
	<div class="wrap bar">
		<span class="muted">© {new Date().getFullYear()} {SITE_TITLE}</span>
		<nav>
			{links.map(({ href, label }) => <a href={href}>{label}</a>)}
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		font-size: 0.9rem;
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1.5rem 2rem;
	}
	nav {
		display: flex;
		gap: 1.25rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--text);
	}
</style>
