---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul>
	{
		projects.map(({ data: { title, description, tags, link, repo, year } }) => {
			const href = link ?? repo;
			return (
				<li>
					<div class="head">
						<h3>{href ? <a href={href}>{title}</a> : title}</h3>
						<span class="leader" aria-hidden="true" />
						{year && <span class="year">{year}</span>}
					</div>
					<p class="muted">{description}</p>
					{tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
					{link && repo && (
						<p class="extra">
							<a href={repo}>Source</a>
						</p>
					)}
				</li>
			);
		})
	}
</ul>

<style>
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 2rem;
	}
	.head {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
	}
	h3 a {
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.leader {
		flex: 1;
		border-bottom: 1px dotted var(--faint);
		opacity: 0.6;
		transform: translateY(-0.3em);
	}
	.year {
		font-size: 0.85rem;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	p {
		margin: 0.35rem 0 0;
	}
	.tags {
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: var(--faint);
	}
	.extra {
		font-size: 0.85rem;
	}
</style>
