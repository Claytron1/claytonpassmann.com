---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { title, description, tags, link, repo } = Astro.props.project.data;
---

<article class="card">
	<h3>{link ? <a href={link}>{title}</a> : title}</h3>
	<p class="muted">{description}</p>
	{tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
	{
		(link || repo) && (
			<p class="links">
				{link && <a href={link}>Live site →</a>}
				{repo && <a href={repo}>Source →</a>}
			</p>
		)
	}
</article>

<style>
	.card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem 1.35rem;
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
		margin-top: 0.85rem;
		font-size: 0.9rem;
	}
</style>
