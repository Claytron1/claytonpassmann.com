---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Writing" description="Writing by Clayton Passmann.">
	<h1>Writing</h1>
	<p class="lede">Notes, ideas, and things I've learned. <a href="/rss.xml">Subscribe via RSS</a>.</p>
	<PostList posts={posts} />
</BaseLayout>
