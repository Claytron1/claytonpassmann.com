---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS, RESUME_PATH } from '../consts';

const hasResume = existsSync(`public${RESUME_PATH}`);

// TODO: replace with your real skills.
const skills = ['Skill one', 'Skill two', 'Skill three', 'Skill four', 'Skill five'];

// TODO: replace with your real experience, most recent first.
const experience = [
	{
		role: 'Job title',
		org: 'Company',
		dates: '2024 — Now',
		summary: 'One or two sentences on what you did and the impact it had.',
	},
	{
		role: 'Previous job title',
		org: 'Previous company',
		dates: '2021 — 2024',
		summary: 'One or two sentences on what you did and the impact it had.',
	},
];

const contact = [
	hasResume && { href: RESUME_PATH, label: 'Download résumé (PDF)' },
	LINKS.email && { href: `mailto:${LINKS.email}`, label: 'Email' },
	LINKS.linkedin && { href: LINKS.linkedin, label: 'LinkedIn' },
	LINKS.github && { href: LINKS.github, label: 'GitHub' },
].filter(Boolean) as { href: string; label: string }[];
---

<BaseLayout title="About" description="About Clayton Passmann — background, skills, and experience.">
	<h1>About</h1>

	<p class="lede">
		<span class="todo">TODO:</span> A short paragraph introducing yourself — what you do, what you care
		about, and what kind of work you're looking for.
	</p>

	<p>
		<span class="todo">TODO:</span> A second paragraph with a bit more personality: how you got here, what
		you're learning right now, what you do outside of work.
	</p>

	{
		contact.length > 0 && (
			<ul class="inline-links contact">
				{contact.map(({ href, label }) => (
					<li>
						<a href={href}>{label}</a>
					</li>
				))}
			</ul>
		)
	}

	<h2 class="label">Experience</h2>
	<ol class="rows">
		{
			experience.map((job) => (
				<li>
					<span class="when">{job.dates}</span>
					<div>
						<h3>{job.role}</h3>
						<p class="org">{job.org}</p>
						<p class="muted">{job.summary}</p>
					</div>
				</li>
			))
		}
	</ol>

	<h2 class="label">Skills</h2>
	<p class="skills">{skills.join(' · ')}</p>
</BaseLayout>

<style>
	.contact {
		margin-top: 2rem;
	}
	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 2rem;
	}
	.rows li {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.25rem 1.5rem;
	}
	.when {
		padding-top: 0.2rem;
		font-size: 0.85rem;
		color: var(--faint);
		font-variant-numeric: tabular-nums;
	}
	.org {
		margin: 0.1rem 0 0.4rem;
		font-size: 0.9rem;
		color: var(--accent);
	}
	.rows p.muted {
		margin: 0;
	}
	.skills {
		margin: 0;
		color: var(--muted);
	}
	@media (max-width: 520px) {
		.rows li {
			grid-template-columns: 1fr;
		}
	}
</style>
